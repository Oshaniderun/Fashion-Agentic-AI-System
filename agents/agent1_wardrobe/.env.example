# Environment configuration for Agent 1 - Style & Wardrobe Intelligence
APP_ENV=development
HOST=0.0.0.0
PORT=8001

# Database — SQLite is a real local DB (free). Optional Postgres later.
DATABASE_URL=sqlite:///./fashora_agent1.db
# DATABASE_URL=postgresql+psycopg2://fashora:YOUR_PASSWORD@localhost:5432/fashora

# Authentication — replace with your own long random strings
JWT_SECRET=replace_with_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=120
AGENT_SERVICE_TOKEN=replace_with_another_long_random_string

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# AI — FREE Gemini via Google AI Studio (https://aistudio.google.com/apikey)
# Options: 'mock' | 'gemini' | 'openai' | 'anthropic'
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Vision: 'auto' | 'local' | 'clip'
VISION_MODEL_BACKEND=local

# false = no demo@fashora.ai / no auto W001-W005 seed (recommended)
SEED_DEMO_DATA=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
