# Copy to .env — never commit real secrets.

VITE_API_DOCS_URL=http://127.0.0.1:8001/docs

# Optional photo behind the main content area (leave empty for the plain look).
# Put the file in frontend/public/backgrounds/ and reference it from the root,
# e.g. VITE_APP_BG_IMAGE=/backgrounds/your-image.jpg
# If unset, theme.css decides the background via --app-bg-image.
VITE_APP_BG_IMAGE=
