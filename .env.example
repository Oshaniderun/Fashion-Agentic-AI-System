# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider (pick ONE for the whole team)
LLM_PROVIDER=gemini
LLM_API_KEY=your_key_here
LLM_MODEL=gemini-3.6-flash

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fashora
# Or for local dev without Postgres installed:
# DATABASE_URL=sqlite:///./fashora.db

# Vector DB (Chroma runs locally, no key needed — placeholder for future swap)
VECTOR_DB_PATH=./chroma_db

# Auth & Security (Must be set to strong, random values in production)
# In production (ENVIRONMENT=production), JWT_SECRET and AGENT_SERVICE_TOKEN are strictly required.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRY_MINUTES=60

# Agent-to-agent service token (shared secret so agents trust each other's calls)
AGENT_SERVICE_TOKEN=replace_with_another_random_string

# CORS Allowed Origins (comma-separated list of allowed web origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000


# Agent service hosts/ports (fixed so services can find each other)
# When running locally without Docker, use localhost. Inside docker-compose,
# use the service name instead (e.g. AGENT2_HOST=agent2_retrieval).
AGENT1_HOST=localhost
AGENT1_PORT=8001
AGENT2_HOST=localhost
AGENT2_PORT=8002
AGENT3_HOST=localhost
AGENT3_PORT=8003
AGENT4_HOST=localhost
AGENT4_PORT=8004
ORCHESTRATOR_HOST=localhost
ORCHESTRATOR_PORT=8000

# ---------------------------------------------------------------------------
# Agent 4 (decision service) — extension tuning keys. All NON-SECRET.
# Every key is optional: the service uses the default shown when it is absent.
# Meaning of each key: agents/agent4_decision/README.md
# ---------------------------------------------------------------------------

# Feature 1 - score breakdown weights. Must sum to 1.0 (validated at startup).
SB_W_COLOUR_HARMONY=0.25
SB_W_FORMALITY_MATCH=0.20
SB_W_OCCASION_FIT=0.20
SB_W_BUDGET_FIT=0.15
SB_W_CONSTRAINT_SAT=0.20
MAX_BREAKDOWN_CANDIDATES=4
SCORE_WEIGHTS_VERSION=breakdown-v1

# Feature 2 - structured rejection + re-optimization retry cap.
# FORCED_LOW_CONFIDENCE_SCORE must stay below LOW_CONFIDENCE_THRESHOLD.
MAX_REOPTIMIZATION_ROUNDS=3
LOW_CONFIDENCE_THRESHOLD=0.50
FORCED_LOW_CONFIDENCE_SCORE=0.40
MAX_EXCLUDED_PRODUCT_IDS=50

# Feature 3 - explanation faithfulness check reporting limits.
MAX_VERIFICATION_ISSUES=10
VERIFICATION_ISSUE_TEXT_LIMIT=60

# Feature 4 - counterfactual search bounds (cost limits, not accuracy knobs).
MAX_COUNTERFACTUALS=3
COUNTERFACTUAL_BUDGET_MAX_INCREASE_USD=500.0
COUNTERFACTUAL_MAX_SWAP_PROBES=12

# Feature 5 - decision audit log + bias harness.
# AUDIT_DB_PATH stays commented to use the repo-absolute default
# agents/agent4_decision/data/audit.db (that file holds hashes, never input text).
AUDIT_ENABLED=true
# AUDIT_DB_PATH=
AUDIT_MAX_PAGE_SIZE=100
AUDIT_DEFAULT_PAGE_SIZE=20
AUDIT_LOCK_TIMEOUT_SECONDS=5.0
BIAS_FLAG_THRESHOLD=0.05
