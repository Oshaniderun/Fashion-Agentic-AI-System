# Copy this file to .env and fill in the CHANGE_ME secrets. Never commit .env.
# The four secrets (DB password, LLM_API_KEY, JWT_SECRET, AGENT_SERVICE_TOKEN)
# are shared by the team via a PRIVATE channel (chat/DM), never through git.

# LLM provider (pick ONE for the whole team)
LLM_PROVIDER=gemini
LLM_API_KEY=CHANGE_ME_gemini_api_key
LLM_MODEL=gemini-3.6-flash

# Database
# Shared team DB (host = the machine running Postgres, currently 192.168.1.9):
DATABASE_URL=postgresql+psycopg2://fashora:CHANGE_ME_db_password@192.168.1.9:5432/fashora
# Or your OWN local Postgres:
# DATABASE_URL=postgresql+psycopg2://fashora:CHANGE_ME_db_password@localhost:5432/fashora
# Or local dev without Postgres installed:
# DATABASE_URL=sqlite:///./fashora.db

# Vector DB (Chroma runs locally, no key needed — placeholder for future swap)
VECTOR_DB_PATH=./chroma_db

# Auth & Security (Must be set to strong, random values in production)
# In production (ENVIRONMENT=production), JWT_SECRET and AGENT_SERVICE_TOKEN are strictly required.
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_EXPIRY_MINUTES=120

# Agent-to-agent service token (shared secret so agents trust each other's calls)
# MUST be identical across all agents/teammates.
AGENT_SERVICE_TOKEN=CHANGE_ME_agent_service_token

# CORS Allowed Origins (comma-separated list of allowed web origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000


# Agent service hosts/ports (fixed so services can find each other)
# When running locally without Docker, use localhost. Inside docker-compose,
# use the service name instead (e.g. AGENT2_HOST=agent2_retrieval).
AGENT1_HOST=localhost
AGENT1_PORT=8001
AGENT2_HOST=localhost
AGENT2_PORT=8002
AGENT3_HOST=localhost
AGENT3_PORT=8003
AGENT4_HOST=localhost
AGENT4_PORT=8004
ORCHESTRATOR_HOST=localhost
ORCHESTRATOR_PORT=8000
